  year      = "2025",
  month     = dec,
  doi       = "10.1109/GLOBECOM59602.2025.11431721",
  language  = "English",
  isbn      = "979-8-3315-7782-7",
  series    = "Proceedings - IEEE Global Communications Conference, GLOBECOM",
  publisher = "IEEE",
  pages     = "3268--3273",
